{
  "realm": "orbita",
  "enabled": true,
  "displayName": "Orbita Local",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@local.orbita",
    "fromDisplayName": "Orbita Local",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "roles": {
    "realm": [
      { "name": "organization_admin" },
      { "name": "principal" },
      { "name": "finance_admin" },
      { "name": "project_manager" },
      { "name": "project_member" },
      { "name": "field_supervisor" },
      { "name": "contractor" },
      { "name": "consultant" },
      { "name": "owner" },
      { "name": "vendor" }
    ]
  },
  "clients": [
    {
      "clientId": "orbita-web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*", "http://192.168.29.157:3000/*"],
      "webOrigins": ["http://localhost:3000", "http://192.168.29.157:3000"],
      "protocolMappers": [
        {
          "name": "organization_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "organization_id",
            "claim.name": "organization_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        }
      ]
    },
    {
      "clientId": "orbita-mobile",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["orbita://*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "organization_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "organization_id",
            "claim.name": "organization_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        }
      ]
    },
    {
      "clientId": "orbita-api",
      "bearerOnly": true,
      "standardFlowEnabled": false
    },
    {
      "clientId": "orbita-provisioner",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountClientRoles": {
        "realm-management": ["manage-users", "view-users"]
      }
    }
  ],
  "users": [
    {
      "username": "pilot-admin",
      "enabled": true,
      "email": "pilot-admin@local.orbita",
      "emailVerified": true,
      "firstName": "Pilot",
      "lastName": "Administrator",
      "credentials": [{ "type": "password", "value": "pilot_local", "temporary": false }],
      "realmRoles": ["organization_admin"],
      "attributes": { "organization_id": ["northline-studio"] }
    },
    {
      "username": "pilot-contractor",
      "enabled": true,
      "email": "pilot-contractor@local.orbita",
      "emailVerified": true,
      "firstName": "Pilot",
      "lastName": "Contractor",
      "credentials": [{ "type": "password", "value": "pilot_contractor", "temporary": false }],
      "realmRoles": ["contractor"],
      "attributes": { "organization_id": ["northline-studio"] }
    }
  ]
}
