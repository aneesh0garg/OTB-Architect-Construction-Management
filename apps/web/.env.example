# Comma-separated LAN hostnames/IP addresses permitted to load Next development assets.
# Add the computer's current Wi-Fi address before opening the app from a physical phone.
# Example: ORBITA_WEB_ALLOWED_DEV_ORIGINS=192.168.29.157
ORBITA_WEB_ALLOWED_DEV_ORIGINS=

# Local API used by the web workspace.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Local Keycloak realm used by the web workspace.
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8180/realms/orbita
