# Reusable physical-device host. Next permits this host to load development assets.
# Example: ORBITA_LAN_HOST=192.168.29.157
ORBITA_LAN_HOST=
# Comma-separated additional LAN hostnames/IP addresses, if required.
ORBITA_WEB_ALLOWED_DEV_ORIGINS=

# Local API used by the web workspace. When opened from a LAN address, the web
# app automatically substitutes that address for localhost.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Local Keycloak realm used by the web workspace.
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8180/realms/orbita
